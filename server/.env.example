# Verified Match Backend - Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/verified-match
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/verified-match

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Email Configuration (for notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@verifiedmatch.uk

# AWS S3 Configuration (for profile photos)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=verified-match-photos
AWS_REGION=eu-west-2

# Frontend URLs
FRONTEND_URL=http://localhost:3000
FRONTEND_GITHUB_PAGES=https://dansfootytipsukofficial-tech.github.io/verified-match

# Stripe Payment Configuration (for premium features)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Redis Configuration (for caching & sessions)
REDIS_URL=redis://localhost:6379

# Twilio Configuration (for SMS verification)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Match Algorithm Configuration
MIN_AGE_DIFFERENCE=2
MAX_AGE_DIFFERENCE=10
MIN_DISTANCE_KM=1
MAX_DISTANCE_KM=50

# Security
CORS_ORIGIN=http://localhost:3000,https://dansfootytipsukofficial-tech.github.io
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
